{
  "rewrites": [
    { "source": "/api/stripe/:action", "destination": "/api/stripe" },
    { "source": "/api/subscriptions/:action", "destination": "/api/subscriptions" },
    { "source": "/api/analytics/:action", "destination": "/api/analytics" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/reconcile-paid-orders", "schedule": "0 8 * * *" }
  ]
}
